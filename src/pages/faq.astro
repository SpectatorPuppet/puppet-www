---
import Base from '../layouts/Base.astro';
import Faqs from '../components/Faqs.astro';
import Cta from '../components/Cta.astro';
import { faqs } from '../data/site';
const ld = [{ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Base title="FAQ: Puppet Tasks and Booking Questions Answered" description="Answers about Puppet: pricing, trial and launch offer, BYO AI keys vs Pro, custom domains, mobile apps, data security, voice recordings and cancelling." path="/faq" ld={ld} crumbs={[['FAQ', '/faq']]}>
<Fragment slot="hero"><h1>Frequently asked questions</h1><p>Everything people ask before they sign up.</p></Fragment>
<section><div class="w" style="max-width:820px"><Faqs items={faqs} /></div></section>
<Cta />
</Base>
