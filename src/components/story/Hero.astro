---
// Section 1: hero and app reveal. Track is 250vh (set in story.css under .story-on); the stage
// sticks for the whole track while story.ts scrubs the copy up and the portal from tilted to flat.
import Portal from './Portal.astro';
import { links, trialDays, launchOffer } from '../../data/site';
---
<section class="s-hero track" data-story="hero" aria-labelledby="hero-h">
  <div class="stage">
    <div class="copy" data-beat="copy">
      <p class="kicker">The Puppet account</p>
      <h1 id="hero-h">One account for every app your business runs</h1>
      <p class="sub">Sign in once, pay one bill and decide who gets into what. Every Puppet app plugs into the same account, with AI you control.</p>
      <div class="row"><a class="btn" href={links.signup}>Start {trialDays}-day trial</a><a class="btn gh" href={links.demo}>Book a demo</a></div>
      <p class="trust"><b>Launch offer:</b> {launchOffer} <a href={links.tasksDemo}>Try the live demo</a></p>
    </div>
    <div class="persp"><div class="tilt" data-beat="app"><Portal /></div></div>
    <p class="hint" data-beat="hint" aria-hidden="true">Scroll</p>
  </div>
</section>
<style>
.s-hero{background:radial-gradient(120% 70% at 50% 0%,#3a3a3d 0%,#2a2a2a 55%,#1f1f22 100%);color:#fff;padding:0;overflow:clip}
.stage{display:flex;flex-direction:column;align-items:center;gap:40px;padding:72px 20px 64px;text-align:center}
.copy{max-width:860px}.kicker{margin:0 0 14px;color:#ff8a80;font-weight:600;letter-spacing:.02em}
.s-hero h1{font-size:clamp(38px,6.4vw,80px);letter-spacing:-.025em;line-height:1.02;margin:0 0 18px}
.sub{margin:0 auto;color:#c0c0c0;font-size:clamp(17px,1.6vw,21px);max-width:36em}
.row{justify-content:center}.trust{color:#c0c0c0;font-size:14px;margin:0}.trust b{color:#fff}
.persp{width:min(1080px,100%);perspective:1400px}.tilt{transform-origin:50% 0%;will-change:transform}
.hint{display:none;margin:0;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#c0c0c0}
</style>
