---
// Section 2: pinned walkthrough. Track is 300vh; three beats at 0-33%, 33-66% and 66-100% of it.
// Each beat fades one callout in on the side and changes what the portal shows (see story.ts).
import Portal from './Portal.astro';
const steps = [
  { k: '01', h: 'One sign-in for every app', p: 'Your team signs in once with their Puppet account and opens any app you have turned on.' },
  { k: '02', h: 'One bill, clear usage', p: 'Seats, plans and AI usage for every app on one page, with a monthly AI budget you set.' },
  { k: '03', h: 'Decide who gets in', p: 'Invite staff and outside guests, then choose their role in each app. Take access away in one click.' },
];
---
<section class="s-walk track" data-story="walk" aria-labelledby="walk-h">
  <div class="stage">
    <div class="side-copy">
      <h2 id="walk-h">Run your whole business from one account</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" data-beat="step" data-i={i}><span class="k">{s.k}</span><h3>{s.h}</h3><p>{s.p}</p></li>
        ))}
      </ol>
      <div class="prog" aria-hidden="true"><i data-beat="prog"></i></div>
    </div>
    <div class="frame"><Portal id="walk-board" /></div>
  </div>
</section>
<style>
.s-walk{background:#f3f3f4;padding:0}
.stage{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:56px;align-items:center;max-width:1320px;margin:auto;padding:80px 20px}
.s-walk h2{font-size:clamp(28px,3.6vw,46px);letter-spacing:-.02em;margin-bottom:24px}
.steps{list-style:none;margin:0;padding:0;display:grid;gap:22px}
.step{border-left:3px solid #d4d4d8;padding-left:18px}.step h3{font-size:22px;margin:4px 0}.step p{margin:0;color:#5c5c5c;font-size:17px}
.k{font:600 12px "IBM Plex Mono",ui-monospace,monospace;color:#b30a05}
.prog{display:none;height:3px;border-radius:2px;background:#d4d4d8;margin-top:28px;overflow:hidden}.prog i{display:block;height:100%;width:100%;background:#e10600;transform:scaleX(0);transform-origin:left}
@media (max-width:900px){.stage{grid-template-columns:1fr;gap:28px;padding:56px 20px}}
</style>
